# ── DATABASE ─────────────────────────────────────────────────
DB_SERVER=your-server.database.windows.net
DB_PORT=1433
DB_NAME=jupiteroneusa
DB_USER=jupiteradmin
DB_PASSWORD=YourStrongPasswordHere

# ── JWT AUTH ──────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_very_long_random_string_in_production
JWT_EXPIRES_IN=7d
ADMIN_JWT_SECRET=different_long_random_string_for_admin

# ── EMAIL ─────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=DTorchia@jupiteroneusa.com
SMTP_PASS=your_gmail_app_password
RFQ_NOTIFY_EMAIL=DTorchia@jupiteroneusa.com
ADMIN_COPY_EMAIL=nicolle@jupiteroneusa.com
RETURN_APPROVER_EMAIL=nicolle@jupiteroneusa.com

# ── AZURE BLOB STORAGE (for documents/PDFs) ───────────────────
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...
AZURE_STORAGE_CONTAINER=jupiter-one-docs

# ── ADMIN ─────────────────────────────────────────────────────
ADMIN_EMAIL=DTorchia@jupiteroneusa.com
ADMIN_PASSWORD=ChangeMe123!
SESSION_SECRET=another_long_random_string

# ── SERVER ────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
FRONTEND_URL=https://jupiteroneusa.com
